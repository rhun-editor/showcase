# a grammar shipped by an extension: files ending in .showcase get it
name = Showcase Script
files = *.showcase
icon = code purple
comment = #
string = " \
keywords = step say pick ask run mark open wrap
constants = yes no upper lower title reverse
builtins = greeting case brackets
region = #| |# comment multiline
# how the editor types it (every language key):
brackets = () [] {}
autoclose = ( ) [ ] { } " " #| |#
autoclose_code = "
surround = ( ) [ ] { } " "
indent_open = step ^when {$ (
indent_close = done } )
indent_middle = else
indent_dedent_after = stop
continue = #>
doc_block = #|| | |#
fold = indent
fold_markers = #region #endregion
